[Unit]
Description=Run Sofia PT GTFS-RT trip updates capture every 45 seconds

[Timer]
# 45 s, the collector's cadence, as a fixed grid: four series of every
# three minutes, 45 s apart. A restart of the timer or a reboot does not
# move the phase, so snapshot times stay predictable. OnUnitActiveSec=45s
# would also give 45 s, but its phase moves with every restart. Check the
# grid with: systemd-analyze calendar --iterations=8 '*:0/3:00' '*:0/3:45'
# '*:1/3:30' '*:2/3:15'
#
# The packer's healthcheck threshold reads poll_interval_sec from
# cities/sofia.json, while this grid spells 45 s out: change one, change
# the other.
#
# AccuracySec=1s: the default minute of slack would bunch the series
# together. No Persistent=: a catch-up run fetches the feed as it is then,
# not as it was in the missed slot.
OnCalendar=*:0/3:00
OnCalendar=*:0/3:45
OnCalendar=*:1/3:30
OnCalendar=*:2/3:15
AccuracySec=1s

[Install]
WantedBy=timers.target
